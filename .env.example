APP_NAME="AI Bot Platform"
APP_VERSION="1.0.0"
DEBUG=true


# PostgreSQL
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/ai_chat_bot
DB_ECHO=false


# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks


# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434
# Embedding endpoint (defaults: OLLAMA_BASE_URL for ollama, VLLM_BASE_URL for openai)
# EMBEDDING_PROVIDER=openai        # any OpenAI-compatible /v1/embeddings server
# EMBEDDING_BASE_URL=https://ollama.example.com
# EMBEDDING_API_KEY=               # sent as "Authorization: Bearer <key>"
# EMBEDDING_VERIFY_SSL=false       # unset = same as LLM_VERIFY_SSL
# EMBEDDING_TRUST_ENV=true         # unset = same as LLM_TRUST_ENV
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_HEADERS={"X-Tenant": "acme"}
# EMBEDDING_KEEP_ALIVE=30m         # Ollama: keep the model loaded
# Verify with: python -m scripts.check_embeddings


# LLM / vLLM
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=local-vllm
VLLM_DEFAULT_MODEL=llama3.2:latest
VLLM_TIMEOUT=120
LLM_VERIFY_SSL=true
LLM_TRUST_ENV=true


# Redis
REDIS_URL=redis://localhost:6379/0


# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=200
TESSDATA_PREFIX=./data/tessdata
OCR_LANGUAGE=eng
OCR_DPI=150


# Authentication
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30


# RAG
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
# Hybrid index lives in <QDRANT_COLLECTION>_v<RAG_INDEX_VERSION>;
# after changing it run: python -m scripts.reindex_documents
RAG_INDEX_VERSION=2
# Agentic retrieval: grade evidence and refine the query (max rounds)
RAG_AGENTIC=true
RAG_MAX_ROUNDS=2
# Optional cross-encoder reranker, e.g. BAAI/bge-reranker-v2-m3
# RAG_RERANKER_MODEL=
# Disables thinking for internal JSON calls on gemma4/qwen3 (Ollama)
LLM_INTERNAL_REASONING_EFFORT=none
# Clarifying questions / follow-up suggestions from the knowledge base
RAG_CLARIFY=true
RAG_FOLLOWUP_SUGGESTIONS=false
# Topic-only messages up to N words get a clarifying question first
RAG_CLARIFY_MAX_WORDS=2


# Guardrails
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true